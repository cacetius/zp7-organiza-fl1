{
  "name": "ChefProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio vinculado (chave com a conta nativa)"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "N\u00edvel de acesso no sistema"
    },
    "funcao": {
      "type": "string",
      "enum": [
        "lider",
        "monitor",
        "supervisor"
      ],
      "description": "Fun\u00e7\u00e3o do usu\u00e1rio na f\u00e1brica"
    },
    "telefone": {
      "type": "string"
    },
    "equipe": {
      "type": "string"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula (apenas para L\u00edder e Monitor)"
    },
    "turno": {
      "type": "string",
      "enum": [
        "turno1",
        "turno2",
        "turno3"
      ]
    },
    "perfil_completo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "funcao",
    "telefone",
    "equipe",
    "celula",
    "turno"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}