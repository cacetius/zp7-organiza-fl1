{
  "name": "ChefAudit",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "factory_id": {
      "type": "string"
    },
    "area_id": {
      "type": "string"
    },
    "cell_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "tacto_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "auditor_id": {
      "type": "string"
    },
    "auditor_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "planned"
    },
    "result": {
      "type": "string",
      "enum": [
        "approved",
        "approved_with_restrictions",
        "rejected",
        "pending"
      ]
    },
    "score": {
      "type": "number"
    },
    "max_score": {
      "type": "number"
    },
    "percentage": {
      "type": "number"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "category_id": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "comment": {
            "type": "string"
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_conformity": {
            "type": "boolean"
          }
        }
      }
    },
    "general_observations": {
      "type": "string"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nc_count": {
      "type": "number",
      "default": 0
    },
    "action_plans_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "template_id",
    "area_id",
    "status"
  ]
}