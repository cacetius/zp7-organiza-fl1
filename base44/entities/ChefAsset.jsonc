        "label",
        "marking",
        "other"
      ]
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "installation_date": {
      "type": "string",
      "format": "date"
    },
    "useful_life_years": {
      "type": "number"
    },
    "responsible": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "maintenance",
        "calibration",
        "scrapped"
      ],
      "default": "active"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qr_code": {
      "type": "string"
    },
