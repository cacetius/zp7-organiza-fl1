      "type": "string"
    },
    "area_id": {
      "type": "string"
    },
    "factory_id": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "patrimony": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "machine",
        "workbench",
        "scanner",
        "torque_wrench",
        "screwdriver",
        "tool",
        "cabinet",
        "shelf",
        "fifo",
        "fefo",
