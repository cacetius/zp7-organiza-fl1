      "type": "string"
    },
    "position_x": {
      "type": "number"
    },
    "position_y": {
      "type": "number"
    },
    "position_z": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_maintenance_date": {
      "type": "string",
      "format": "date"
    },
    "next_calibration_date": {
      "type": "string",
      "format": "date"
    }
