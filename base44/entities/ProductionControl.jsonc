{
  "name": "ProductionControl",
  "type": "object",
  "properties": {
    "testor_id": {
      "type": "string",
      "description": "ID do testor"
    },
    "testor_nome": {
      "type": "string",
      "description": "Nome do testor"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do registro"
    },
    "turno": {
      "type": "string",
      "enum": [
        "primeiro",
        "segundo",
        "terceiro"
      ],
      "description": "Turno de produ\u00e7\u00e3o"
    },
    "hora": {
      "type": "string",
      "description": "Hora do registro (ex: 15:00)"
    },
    "carros_produzidos": {
      "type": "number",
      "description": "Quantidade de carros produzidos na hora"
    },
    "perdas_producao": {
      "type": "number",
      "default": 0,
      "description": "Perdas por parada/operacional nessa hora"
    },
    "perdas_defeito": {
      "type": "number",
      "default": 0,
      "description": "Perdas por defeito/qualidade nessa hora"
    },
    "objetivo": {
      "type": "number",
      "default": 0,
      "description": "Meta planejada para a hora"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa das perdas nessa hora"
    },
    "justificativa_foto_url": {
      "type": "string",
      "description": "URL da foto anexada \u00e0 justificativa"
    }
  },
  "required": [
    "testor_id",
    "testor_nome",
    "data",
    "turno",
    "hora",
    "carros_produzidos"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "lider"
          }
        },
        {
          "user_condition": {
            "role": "monitor"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "lider"
          }
        },
        {
          "user_condition": {
            "role": "monitor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "lider"
          }
        }
      ]
    }
  }
}