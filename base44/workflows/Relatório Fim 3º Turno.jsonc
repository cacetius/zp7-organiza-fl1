{
  "name": "Relat\u00f3rio Fim 3\u00ba Turno",
  "description": "Envia relat\u00f3rio consolidado do 3\u00ba turno por e-mail \u00e0s 05:55 (ter\u2013s\u00e1b)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "55 5 * * 2-6",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "relat_rio_fim_3_turno",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enviarRelatorioTurno",
